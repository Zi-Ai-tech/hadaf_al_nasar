# Multi-stage build for security
FROM python:3.11-slim as builder

# Install security tools
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Install safety and other security scanners
RUN pip install --no-cache-dir safety bandit

WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Security scanning stage
FROM builder as security-scanner
COPY . .
RUN safety check --full-report
RUN bandit -r app/ -f json -o bandit-report.json

# Final production image
FROM python:3.11-slim as production

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

# Copy installed packages
COPY --from=builder /root/.local /root/.local
COPY . .

# Security hardening
RUN chown -R appuser:appuser /app \
    && chmod -R 755 /app \
    && find /app -type f -name "*.py" -exec chmod 644 {} \;

USER appuser

# Security-related environment variables
ENV PATH="/root/.local/bin:${PATH}"
ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Health check with security focus
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:5000/security/health || exit 1

EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "4", "wsgi:app"]